# Database (docker compose up -d db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5434

# Redis / Sidekiq (docker compose up -d redis)
REDIS_URL=redis://localhost:6380/0
SIDEKIQ_CONCURRENCY=5

# YouTube Data API v3 key (https://console.cloud.google.com -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=

# Devise JWT signing key (rails secret)
DEVISE_JWT_SECRET_KEY=

# Comma separated list of browser origins allowed by CORS
FRONTEND_ORIGIN=http://localhost:5148

# Rack::Attack rate limiting (disabled by default in the test environment)
RACK_ATTACK_ENABLED=true
